# Copy to .env. Keep the real file out of version control.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./pawnsteps.db
JWT_SECRET=replace-with-a-random-secret-at-least-48-characters-long
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","backend","testserver"]
TIMEZONE=Asia/Shanghai

# Compose replaces DATABASE_URL with the PostgreSQL service URL.
# Use a URL-safe random password, such as: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-random-url-safe-database-password
HTTP_PORT=8080
HTTP_BIND=127.0.0.1

# Development can opt into logging email codes locally.
SMTP_ALLOW_CONSOLE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true

# WeChat Open Platform website application with an approved callback domain.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:8000/api/auth/wechat/callback

STORAGE_BACKEND=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Used only by the explicit admin bootstrap command.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
